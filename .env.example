# Conexión a Postgres (Neon)
DATABASE_URL=postgresql://usuario:contraseña@host/neondb?sslmode=require
# Secreto para firmar las sesiones (cadena larga y aleatoria)
SESSION_SECRET=
# IA principal: Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_QUICK=llama-3.1-8b-instant
# Fotos y respaldo: Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
NODE_ENV=production
