# Conexión a Postgres (Neon)
DATABASE_URL=postgresql://usuario:contraseña@host/neondb?sslmode=require
# Secreto para firmar las sesiones (cadena larga y aleatoria)
SESSION_SECRET=
# Clave de la API de Anthropic para las funciones de IA
ANTHROPIC_API_KEY=
# Opcional: modelos
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_QUICK=claude-haiku-5-5
NODE_ENV=production
