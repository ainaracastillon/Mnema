# Conexión a Postgres (Neon)
DATABASE_URL=postgresql://usuario:contraseña@host/neondb?sslmode=require
# Secreto para firmar las sesiones (cadena larga y aleatoria)
SESSION_SECRET=
# IA principal: Grok (xAI) — https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-latest
XAI_MODEL_QUICK=grok-4.20-0309-non-reasoning
# IA rápida y de respaldo: Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
NODE_ENV=production
